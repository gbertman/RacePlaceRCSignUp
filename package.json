{
  "name": "raceplacerc",
  "version": "1.0.0",
  "description": "RC racing signup application",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "concurrently \"npm run server:dev\" \"npm run client\"",
    "server:dev": "node server/index.js",
    "client": "npm start --prefix client",
    "build": "npm ci --omit=dev --prefix server && npm ci --include=dev --prefix client && npm run build --prefix client",
    "lint": "eslint . --max-warnings 0",
    "test": "npm test --prefix server"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.4",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.9.0"
  }
}
